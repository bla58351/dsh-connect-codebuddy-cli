{
  "name": "dsh-connect-codebuddy-cli",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "把 CodeBuddy 的模型接进 DSH 的模型选择器：选中 CodeBuddy 模型后，这一轮推理由本机已登录的 CodeBuddy CLI 执行，DSH 只负责显示与传输。",
  "icon": "./assets/icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./src/client/index.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "src/**/*.js",
    "src/**/*.mjs",
    "cordis.patch.yml",
    "assets/icon.svg",
    "locale/*.json",
    "README.md",
    "CHANGELOG.md",
    "docs/*.md",
    "scripts/*.mjs"
  ],
  "scripts": {
    "test": "node scripts/check.mjs && node scripts/check-docs.mjs && node scripts/test.mjs",
    "test:live": "node scripts/test.mjs --live",
    "check": "node scripts/check.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "external": [
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-llm": {
      "optional": true
    }
  }
}
